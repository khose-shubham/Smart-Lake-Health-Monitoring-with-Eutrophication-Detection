# ═══════════════════════════════════════════════════════════════════
#  Smart Lake Monitor — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lake_monitor

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Device API Key (must match ESP32 firmware)
DEVICE_API_KEY=lake-monitor-api-key-2024

# Email Notifications (optional — set ENABLE_EMAIL=true to activate)
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=admin@example.com

# Telegram Notifications (optional)
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
